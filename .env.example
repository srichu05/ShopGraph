# ==============================================================================
# ShopGraph — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your configuration.
# Never commit .env to version control.

# Application Environment
APP_ENV=development

# ------------------------------------------------------------------------------
# Neo4j Database Connection
# ------------------------------------------------------------------------------
# For Local Neo4j:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j

# For Neo4j Aura Cloud:
NEO4J_URI=neo4j+s://<your-aura-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-aura-password>
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# Data Preprocessing & Ingestion Settings
# ------------------------------------------------------------------------------
# Mode: "sample" for development subset, "full" for complete dataset
PROCESSING_MODE=sample
SAMPLE_PRODUCTS=10000
SAMPLE_REVIEWS=50000
INGEST_BATCH_SIZE=2000

# ------------------------------------------------------------------------------
# LLM Provider Configuration (gemini or groq)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# For Groq:
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# Vector Embeddings Configuration
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# Retrieval & Recommendation Scoring Parameters
# ------------------------------------------------------------------------------
NEO4J_QUERY_TIMEOUT_MS=10000
NEO4J_MAX_RESULTS=50
DEFAULT_RETRIEVAL_LIMIT=10
RRF_K=60

# Explainable Recommendation Weights (sum to 1.0)
REC_WEIGHT_CATEGORY=0.20
REC_WEIGHT_RATING=0.25
REC_WEIGHT_PRICE=0.15
REC_WEIGHT_BRAND=0.10
REC_WEIGHT_SEMANTIC=0.15
REC_WEIGHT_PURCHASER_OVERLAP=0.15
