# ==============================================================================
# ShopGraph — Docker Ignore Configuration
# ==============================================================================
.git
.gitignore
.env
.env.*
!.env.example

# Frontend assets (deployed independently to Vercel)
frontend/
node_modules/

# Local data & scratch directories
data/raw/
data/processed/*.jsonl
data/processed/*.json
data/processed/*.npy
data/dumps/
*.dump
scratch/
backend/scratch/

# Tests & caches
tests/
backend/tests/
test_*.py
*_test.py
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Python caches & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# IDE & OS files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
